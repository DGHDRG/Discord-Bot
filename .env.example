# Core Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_ID=your_bot_discord_id_here
PREFIX=&

# Database Configuration (PostgreSQL)
# Railway will automatically provide DATABASE_URL, or you can set it manually:
# postgresql://user:password@localhost:5432/discord_bot
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Optional: Legacy MongoDB Support (if not using PostgreSQL)
MONGO_TOKEN=

# Discord Bot Features
DISCORD_STATUS="Listening to meself, I'm a stupid bot, https://github.com/corwindev/discord-bot"

# Third-party API Tokens
GIPHY_TOKEN=
TOPGG_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
OPENAI=

# Music Features (Lavalink)
LAVALINK_HOST=lava.link
LAVALINK_PASSWORD=I'm a secret
LAVALINK_PORT=80
LAVALINK_SECURE=false

# Radio Features
RADIO=

# Webhook Logging (Optional)
WEBHOOK_ID=
WEBHOOK_TOKEN=

# Environment
NODE_ENV=production

